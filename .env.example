# SOLA environment template (copy to .env and fill real values; .env* is gitignored.
FLASK_SECRET_KEY=change-me
# Storage backend: sqlite (default) | sheets (Phase 5: live Google Sheet store)
STORAGE=sqlite
# Media (production uploads) backend: local (default, dev) | cloud backend wired in app/mediastore.py
# On Vercel (read-only FS), uploads are skipped with a clear message unless a cloud backend is set.
MEDIA_STORAGE=local
# Local upload directory (dev only; default is app/static/uploads)
# MEDIA_UPLOAD_DIR=
# SQLite default: instance/sola.db (relative to project root)
DATABASE_URL=sqlite:///instance/sola.db
# Public tracking /track — set a hard rate limit (anti-abuse, spec §20)
TRACKING_RATE_LIMIT=30
# Optional Google Sheets read/write for the source-of-truth sheet (least-privilege scope: spreadsheets)
SPREADSHEET_ID=1z2cV5CCrc99rve4ObUdouf6Nw_8Qw8MQMr7LExYHNwA
# Service account for the SOLA sheet (private/write ops; public export needs no auth).
# Key stored at D:/Sola/instance/sola-509413-service-account.json (gitignored, NOT committed).
# SOURCE email (authoritative per Ejak 2026-09-22): evaaccount@sola-509413.iam.gserviceaccount.com
# NOTE: for authenticated read/write the sheet's sharing must grant access to that email
GOOGLE_APPLICATION_CREDENTIALS=D:/Sola/instance/sola-509413-service-account.json